rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'ptk@prazocerto.app';
    }
    function isSupplier() {
      return request.auth != null && request.auth.token.email == 'vorcaro@prazocerto.app';
    }
    function isReseller() {
      return request.auth != null
        && exists(/databases/$(database)/documents/resellers/$(request.auth.uid))
        && get(/databases/$(database)/documents/resellers/$(request.auth.uid)).data.active == true;
    }
    match /settings/{id} {
      allow read: if isOwner() || isReseller() || isSupplier();
      allow write: if isOwner();
    }
    match /products/{id} {
      allow read: if isOwner() || isReseller();
      allow write: if isOwner();
      allow update: if isReseller()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
    }
    match /productCosts/{id} { allow read, write: if isOwner(); }
    match /supplierPurchases/{id} {
      allow read: if isOwner() || isSupplier();
      allow write: if isOwner();
    }
    match /supplierPayments/{id} {
      allow read: if isOwner() || isSupplier();
      allow write: if isOwner();
    }
    match /supplierInfo/{id} { allow read, write: if isOwner() || isSupplier(); }
    match /shipments/{id} {
      allow read: if isOwner() || isSupplier();
      allow create: if isOwner() || (isSupplier() && request.resource.data.status == 'pendente');
      allow update, delete: if isOwner();
    }
    match /resellers/{id} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == id);
      allow write: if isOwner();
    }
    match /sales/{id} {
      allow read: if isOwner() || (isReseller() && resource.data.resellerId == request.auth.uid);
      allow create: if isOwner() || (isReseller()
        && request.resource.data.resellerId == request.auth.uid
        && request.resource.data.canceled == false);
      allow update, delete: if isOwner();
    }
    match /payments/{id} {
      allow read: if isOwner() || (isReseller() && resource.data.resellerId == request.auth.uid);
      allow create: if isOwner() || (isReseller()
        && request.resource.data.resellerId == request.auth.uid
        && request.resource.data.status == 'pendente');
      allow update, delete: if isOwner();
    }
  }
}
